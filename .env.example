#--------------------------------------------------------------------------------
## 1. app settings

NODE_ENV=development

### servers
WEB_PORT=4040
NEXT_PUBLIC_WEB_SERVER=http://localhost:${WEB_PORT}
FASTAPI_PORT=40401
NEXT_PUBLIC_FASTAPI_SERVER=http://localhost:${FASTAPI_PORT}

#--------------------------------------------------------------------------------
## 2. database

PGDATABASE=falconup
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=postgres
PGPORT=5432

DATABASE_URL=postgresql://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${PGDATABASE}

#--------------------------------------------------------------------------------
## 2a. auth (Better Auth)

BETTER_AUTH_SECRET=          # openssl rand -base64 32
NEXT_PUBLIC_BETTER_AUTH_URL=${NEXT_PUBLIC_WEB_SERVER}

#--------------------------------------------------------------------------------
## 2b. redis

REDIS_URL=redis://localhost:6379/0

#--------------------------------------------------------------------------------
## 3. market data APIs (fill in the ones you use)

# https://www.alphavantage.co — free tier: 25 req/day
# ALPHA_VANTAGE_API_KEY=

# https://twelvedata.com — free tier: 800 req/day
# TWELVE_DATA_API_KEY=

# https://polygon.io — free tier: 5 req/min, delayed
# POLYGON_API_KEY=

# https://finnhub.io — free tier: 60 req/min
# FINNHUB_API_KEY=

# https://fred.stlouisfed.org/docs/api/fred/ — macro data
FRED_API_KEY=
