# Load environment variables from the root of the prroject .env (self-contained).
# _if_exists so a fresh checkout (where .env is gitignored, hence absent)
# doesn't abort direnv before PYTHONPATH/venv are set up below.
dotenv_if_exists ../.env

# Set PYTHONPATH for backend python app
export PYTHONPATH=.

# Activate python virtual environment
source .venv/bin/activate
