FROM node:24-slim

ARG NEXT_PUBLIC_FASTAPI_SERVER
ENV NEXT_PUBLIC_FASTAPI_SERVER=$NEXT_PUBLIC_FASTAPI_SERVER

WORKDIR /app

# Install dependencies first (cached layer)
COPY package.json package-lock.json* ./
RUN npm ci

# Copy application code
COPY . .

RUN npm run build

CMD ["npm", "start", "--", "-p", "4040"]
